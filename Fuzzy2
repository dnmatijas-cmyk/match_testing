source_table = "SANDBOX.DMATIJAS.ENTERPRISE_ACTIVE_WORKERS"

try:
    # ── 1. Pull unprocessed records from Snowflake ──────────────────────
    query = f"""
        SELECT
            RECORD_ID,
            WORKER_ID,
            CLIENT_ID,
            CLIENT_NAME,
            FIRST_NAME,
            LAST_NAME
        FROM {source_table}
        WHERE API_PROCESSED = FALSE;
    """

    rows = pd.DataFrame(session.sql(query).collect())
    print(f"\nProcessing {rows.shape[0]} rows")

    # ── 2. Set request headers ───────────────────────────────────────────
    HEADERS = {
        'Content-Type': 'application/json',
        'X-api-key': API_KEY
    }

    success_count = 0
    error_count = 0

    # ── 3. Iterate rows, call PDL, write response back to source row ─────
    for idx, row in rows.iterrows():
        try:
            # Sanitise inputs
            first_name = (
                row['FIRST_NAME'].replace("'", "''")
                if pd.notna(row['FIRST_NAME']) else ""
            )
            last_name = (
                row['LAST_NAME'].replace("'", "''")
                if pd.notna(row['LAST_NAME']) else ""
            )
            account_name = (
                row['CLIENT_NAME'].replace("'", "''")
                if pd.notna(row['CLIENT_NAME']) else ""
            )
            record_id_sql = str(row['RECORD_ID']).replace("'", "''")

            # ── Fuzzy + wildcard ES query ────────────────────────────────
            # All clauses are 'should' - no hard requirements.
            # minimum_should_match=2 means at least 2 signals must align,
            # preventing a single token from pulling everyone with that name
            # while still being loose enough to handle dirty/abbreviated data.
            PARAMS = {
                'query': {
                    "bool": {
                        "should": [
                            # First name wildcard (Jon vs Jonathan)
                            {
                                "wildcard": {
                                    "first_name": {
                                        "value": first_name.lower() + "*"
                                    }
                                }
                            },
                            # Last name fuzzy
                            {
                                "match": {
                                    "last_name": {
                                        "query": last_name.lower(),
                                        "fuzziness": "1"
                                    }
                                }
                            },
                            # Last name wildcard
                            {
                                "wildcard": {
                                    "last_name": {
                                        "value": last_name.lower() + "*"
                                    }
                                }
                            },
                            # Company name fuzzy
                            {
                                "match": {
                                    "job_company_name": {
                                        "query": account_name.lower(),
                                        "fuzziness": "AUTO"
                                    }
                                }
                            },
                            # Company name wildcard
                            {
                                "wildcard": {
                                    "job_company_name": {
                                        "value": "*".join(account_name.lower().split()) + "*"
                                    }
                                }
                            }
                        ],
                        "minimum_should_match": 2
                    }
                },
                'size': 5,
                'pretty': True,
                'titlecase': True
            }

            # ── Fire request ─────────────────────────────────────────────
            response = requests.get(
                PDL_URL,
                headers=HEADERS,
                params={"api_key": API_KEY},
                json=PARAMS,
                verify=ssl_verify
            ).json()

            response_status = response.get('status', None)
            response_data   = json.dumps(response.get('data', []))
            total_matches   = int(response.get('total', 0))
            response_time   = str(datetime.now())

            # ── Write response back to source table row ──────────────────
            # Requires these columns on the source table:
            #   API_PROCESSED        BOOLEAN
            #   API_PROCESSED_AT     TIMESTAMP
            #   API_RESPONSE_STATUS  NUMBER
            #   API_RESPONSE_DATA    VARIANT
            #   API_TOTAL_MATCHES    NUMBER
            #   API_RESPONSE_TIME    VARCHAR
            update_query = f"""
                UPDATE {source_table}
                SET
                    API_PROCESSED        = TRUE,
                    API_PROCESSED_AT     = CURRENT_TIMESTAMP(),
                    API_RESPONSE_STATUS  = {response_status if response_status is not None else 'NULL'},
                    API_RESPONSE_DATA    = PARSE_JSON($${response_data}$$),
                    API_TOTAL_MATCHES    = {total_matches},
                    API_RESPONSE_TIME    = '{response_time}'
                WHERE RECORD_ID = '{record_id_sql}';
            """
            session.sql(update_query).collect()

            # ── Log progress ─────────────────────────────────────────────
            if response_status == 200:
                success_count += 1
                print(
                    f"Row {idx + 1}/{rows.shape[0]}: "
                    f"Match found for {first_name} {last_name} "
                    f"({total_matches} candidates) - updated RECORD_ID {record_id_sql}"
                )
            else:
                print(
                    f"Row {idx + 1}/{rows.shape[0]}: "
                    f"No match for {first_name} {last_name} "
                    f"- Status: {response_status} - updated RECORD_ID {record_id_sql}"
                )

            # Small delay to avoid rate limiting
            time.sleep(1)

        except Exception as row_error:
            error_count += 1
            print(f"Error processing row {idx + 1} (RECORD_ID {row['RECORD_ID']}): {row_error}")

            # Mark row so it doesn't get retried endlessly
            try:
                error_update = f"""
                    UPDATE {source_table}
                    SET
                        API_PROCESSED        = TRUE,
                        API_PROCESSED_AT     = CURRENT_TIMESTAMP(),
                        API_RESPONSE_STATUS  = NULL,
                        API_RESPONSE_DATA    = PARSE_JSON('[]'),
                        API_TOTAL_MATCHES    = 0,
                        API_RESPONSE_TIME    = '{str(datetime.now())}'
                    WHERE RECORD_ID = '{str(row["RECORD_ID"]).replace("'", "''")}';
                """
                session.sql(error_update).collect()
            except Exception as update_error:
                print(f"  Also failed to write error state for RECORD_ID {row['RECORD_ID']}: {update_error}")

    # ── 4. Summary ───────────────────────────────────────────────────────
    print(
        f"\nSummary: {success_count} successful matches, "
        f"{error_count} errors, "
        f"out of {rows.shape[0]} total rows"
    )

except Exception as e:
    print(e)
    raise e

return 'Process Complete'
