def main(session: Session):
    
    try: 
        import _snowflake # Try to import the _snowflake module (needed for Snowflake secrets when deployed to Snowflake Cloud)

        API_KEY = _snowflake.get_generic_secret_string('TOKEN')
        PDL_URL = "https://api.peopledatalabs.com/v5/person/search"
        ssl_verify = True


    except:
        import os
        sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))
        import config # import the config.py file for local debugging



        API_KEY = config.API_KEY
        PDL_URL = "https://api.peopledatalabs.com/v5/person/search"
        ssl_verify = False



    try:
        # env = current_environment(session)
        # Query Snowflake for data 
        query = f"""
                SELECT 
                    RECORD_ID,
                    CLIENT_NAME, 
                    FIRST_NAME,
                    LAST_NAME
                FROM SANDBOX.DMATIJAS.ENTERPRISE_ACTIVE_WORKERS
                WHERE API_PROCESSED = FALSE
                LIMIT 1;

        """
        rows = pd.DataFrame(session.sql(query).collect())

        print(f"Processing {rows.shape[0]} rows")

        
        # Set headers
        HEADERS = {
        'Content-Type': "application/json",
        'X-api-key': API_KEY
        }

        success_count = 0
        error_count = 0

        # Iterate through each row in the dataframe
        for idx, row in rows.iterrows():
            try:
                record_id_sql = str(row['RECORD_ID']).replace("'", "''")

                # Escape single quotes in names to prevent SQL injection/errors
                first_name = row['FIRST_NAME'].replace("'", "''") if pd.notna(row['FIRST_NAME']) else ''
                last_name = row['LAST_NAME'].replace("'", "''") if pd.notna(row['LAST_NAME']) else ''
                account_name = row['CLIENT_NAME'].replace("'", "''") if pd.notna(row['CLIENT_NAME']) else ''
                record_id_sql = str(row['RECORD_ID']).replace("'", "''")
                
                # Create ES Query for Fuszzy Matching
                PARAMS = {
                'query': {
                    "bool": {
                        "should": [
                            # First name wildcard (Jon vs Jonathan)
                            {
                                "wildcard": {
                                    "first_name": {
                                        "value": first_name.lower() + "*"
                                    }
                                }
                            },
                            # Last name fuzzy
                            {
                                "match": {
                                    "last_name": {
                                        "query": last_name.lower(),
                                        "fuzziness": "1"
                                    }
                                }
                            },
                            # Last name wildcard
                            {
                                "wildcard": {
                                    "last_name": {
                                        "value": last_name.lower() + "*"
                                    }
                                }
                            },
                            # Company name fuzzy
                            {
                                "match": {
                                    "job_company_name": {
                                        "query": account_name.lower(),
                                        "fuzziness": "AUTO"
                                    }
                                }
                            },
                            # Company name wildcard
                            {
                                "wildcard": {
                                    "job_company_name": {
                                        "value": "*".join(account_name.lower().split()) + "*"
                                    }
                                }
                            }
                        ],
                        "minimum_should_match": 3
                    }
                },
                'size': 5,
                'pretty': True,
                'titlecase': True
            }


                # Pass the parameters object to the Person Search API
                response = requests.get(
                PDL_URL,
                headers=HEADERS,
                params={"api_key": API_KEY},
                json=PARAMS,
                verify= ssl_verify
                ).json()

                response_status = response.get('status', None)
                response_data   = json.dumps(response.get('data', []))
                total_matches   = int(response.get('total', 0))
                response_time   = str(datetime.now())

                # Write results back to Snowflake source table
                update_query = f"""
                UPDATE SANDBOX.DMATIJAS.ENTERPRISE_ACTIVE_WORKERS
                SET
                    API_PROCESSED        = TRUE,
                    API_PROCESSED_AT     = CURRENT_TIMESTAMP(),
                    API_RESPONSE_STATUS  = {response_status if response_status is not None else 'NULL'},
                    API_RESPONSE_DATA    = PARSE_JSON('{response_data}'),
                    API_TOTAL_MATCHES    = {total_matches},
                    API_RESPONSE_TIME    = '{response_time}'
                WHERE RECORD_ID = '{record_id_sql}';
                """
                session.sql(update_query).collect()

                # Log progress
                if response_status == 200:
                    success_count += 1
                    print(f"Row {idx + 1}/{rows.shape[0]}: Match found for {row['FIRST_NAME']} {row['LAST_NAME']} - Total Matches: {total_matches}")
                else:
                    print(f"Row {idx + 1}/{rows.shape[0]}: No match for {row['FIRST_NAME']} {row['LAST_NAME']} - Status: {response.get('status')}")
                
                # Optional: Add a small delay to avoid rate limiting
                time.sleep(1)

            except Exception as row_error:
                error_count += 1
                print(f"Error processing row {idx + 1} (RECORD_ID {row['RECORD_ID']}): {row_error}")

            # Mark row so it doesn't get retried
            try:
                error_update = f"""
                    UPDATE SANDBOX.DMATIJAS.ENTERPRISE_ACTIVE_WORKERS
                    SET
                        API_PROCESSED        = TRUE,
                        API_PROCESSED_AT     = CURRENT_TIMESTAMP(),
                        API_RESPONSE_STATUS  = NULL,
                        API_RESPONSE_DATA    = PARSE_JSON('[]'),
                        API_TOTAL_MATCHES    = 0,
                        API_RESPONSE_TIME    = '{str(datetime.now())}'
                    WHERE RECORD_ID = '{str(row["RECORD_ID"]).replace("'", "''")}';
                """
                session.sql(error_update).collect()
            except Exception as update_error:
                print(f"  Also failed to write error state for RECORD_ID {row['RECORD_ID']}: {update_error}")

        print(
            f"\nSummary: {success_count} successful matches, "
            f"{error_count} errors, "
            f"out of {rows.shape[0]} total rows"
        )

    except Exception as e:
        print(e)
        raise e

    return 'Process Complete'



